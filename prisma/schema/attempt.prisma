model Attempt {
  id String @id @default(ulid())

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  candidateId  String
  candidate    Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  invitationId String     @unique
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime
  expiresAt   DateTime
  submittedAt DateTime?

  submissions Submission[]
  results     Result?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("attempts")
}
