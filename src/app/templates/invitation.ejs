<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Assessment Invitation</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f7f9;
      font-family: Arial, Helvetica, sans-serif;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="background-color: #f4f7f9; padding: 40px 15px"
    >
      <tr>
        <td align="center">
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            style="
              max-width: 520px;
              background-color: #ffffff;
              border-radius: 12px;
              overflow: hidden;
              border: 1px solid #e5e7eb;
            "
          >
            <!-- Header -->
            <tr>
              <td
                style="
                  background-color: #0f766e;
                  padding: 28px 25px;
                  text-align: center;
                "
              >
                <h1
                  style="
                    margin: 0;
                    color: #ffffff;
                    font-size: 24px;
                    font-weight: 600;
                  "
                >
                  Assessly - Developer Assessment and Coding Platform
                </h1>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding: 40px 35px">
                <h2
                  style="
                    margin: 0 0 15px;
                    color: #111827;
                    font-size: 22px;
                    font-weight: 600;
                  "
                >
                  Assessment Invitation
                </h2>

                <p
                  style="
                    margin: 0 0 10px;
                    color: #374151;
                    font-size: 15px;
                    line-height: 1.7;
                  "
                >
                  Hello <strong><%= name %></strong>,
                </p>

                <p
                  style="
                    margin: 0 0 10px;
                    color: #374151;
                    font-size: 15px;
                    line-height: 1.7;
                  "
                >
                  You have been invited by
                  <strong><%= companyName %></strong>
                  to participate in a developer assessment on Assessly.
                </p>

                <p
                  style="
                    margin: 0 0 25px;
                    color: #6b7280;
                    font-size: 14px;
                    line-height: 1.7;
                  "
                >
                  Use the invitation code below to accept the invitation and
                  continue with your assessment.
                </p>

                <!-- Invitation Code -->
                <div style="text-align: center; margin: 30px 0">
                  <div
                    style="
                      display: inline-block;
                      padding: 16px 30px;
                      background-color: #eff6ff;
                      border: 1px solid #bfdbfe;
                      border-radius: 10px;
                      color: #2563eb;
                      font-size: 30px;
                      font-weight: bold;
                      letter-spacing: 6px;
                    "
                  >
                    <%= invitationCode %>
                  </div>
                </div>

                <!-- Expiration -->
                <p
                  style="
                    margin: 0;
                    color: #6b7280;
                    font-size: 13px;
                    line-height: 1.6;
                    text-align: center;
                  "
                >
                  This invitation code will expire in
                  <strong style="color: #374151">
                    <%= expirationMinutes %> minutes
                  </strong>.
                </p>

                <!-- Info -->
                <div
                  style="
                    margin-top: 28px;
                    padding: 15px;
                    background-color: #f0fdfa;
                    border-radius: 8px;
                    color: #115e59;
                    font-size: 13px;
                    line-height: 1.6;
                  "
                >
                  If you did not expect this invitation, you can safely ignore
                  this email. For your security, do not share this invitation
                  code with anyone.
                </div>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style="
                  padding: 22px 30px;
                  background-color: #f8fafc;
                  text-align: center;
                  border-top: 1px solid #e5e7eb;
                "
              >
                <p
                  style="
                    margin: 0 0 6px;
                    color: #6b7280;
                    font-size: 13px;
                  "
                >
                  Assessly - Developer Assessment and Coding Platform
                </p>

                <p
                  style="
                    margin: 0;
                    color: #9ca3af;
                    font-size: 12px;
                  "
                >
                  © <%= new Date().getFullYear() %> Assessly - Developer
                  Assessment and Coding Platform. All rights reserved.
                </p>

                <p
                  style="
                    margin: 8px 0 0;
                    color: #9ca3af;
                    font-size: 11px;
                  "
                >
                  This is an automated email. Please do not reply.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
